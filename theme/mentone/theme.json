{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1240px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "navy", "name": "Navy", "color": "#041C2C" },
        { "slug": "navy-soft", "name": "Navy soft", "color": "#0d3048" },
        { "slug": "navy-deep", "name": "Navy deep", "color": "#02121c" },
        { "slug": "blue", "name": "Powder blue", "color": "#7DA1C4" },
        { "slug": "blue-soft", "name": "Powder blue soft", "color": "#b3c7db" },
        { "slug": "blue-wash", "name": "Blue wash", "color": "#e6eef6" },
        { "slug": "yellow", "name": "Brand yellow", "color": "#F1B434" },
        { "slug": "yellow-bright", "name": "Yellow bright", "color": "#f5c966" },
        { "slug": "yellow-deep", "name": "Yellow deep", "color": "#c89120" },
        { "slug": "cream", "name": "Cream", "color": "#f6f1e6" },
        { "slug": "cream-warm", "name": "Cream warm", "color": "#efe5cf" },
        { "slug": "off-white", "name": "Off white", "color": "#fafaf7" },
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "muted", "name": "Muted", "color": "#5a6b7a" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "fraunces",
          "name": "Fraunces (display)",
          "fontFamily": "'Fraunces', Georgia, serif"
        },
        {
          "slug": "inter",
          "name": "Inter (body)",
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "13px", "fluid": false },
        { "slug": "medium", "name": "Body", "size": "16px", "fluid": false },
        { "slug": "lead", "name": "Lead", "size": "19px", "fluid": false },
        { "slug": "large", "name": "Card title", "size": "22px", "fluid": false },
        { "slug": "x-large", "name": "Heading 3", "size": "28px", "fluid": false },
        { "slug": "xx-large", "name": "Heading 2", "size": "48px", "fluid": { "min": "32px", "max": "48px" } },
        { "slug": "display", "name": "Display (H1)", "size": "78px", "fluid": { "min": "42px", "max": "78px" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "1 — 4px", "size": "4px" },
        { "slug": "20", "name": "2 — 8px", "size": "8px" },
        { "slug": "30", "name": "3 — 14px", "size": "14px" },
        { "slug": "40", "name": "4 — 20px", "size": "20px" },
        { "slug": "50", "name": "5 — 28px", "size": "28px" },
        { "slug": "60", "name": "6 — 40px", "size": "40px" },
        { "slug": "70", "name": "7 — 56px", "size": "56px" },
        { "slug": "80", "name": "8 — 80px", "size": "80px" },
        { "slug": "90", "name": "9 — Section (110px)", "size": "clamp(72px, 9vw, 110px)" }
      ]
    },
    "custom": {
      "radius": {
        "sm": "3px",
        "md": "4px",
        "pill": "100px"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(4, 28, 44, 0.08)",
        "md": "0 8px 24px rgba(4, 28, 44, 0.12)",
        "lg": "0 24px 60px rgba(4, 28, 44, 0.18)"
      },
      "line": {
        "default": "rgba(4, 28, 44, 0.12)",
        "light": "rgba(4, 28, 44, 0.08)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--navy)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "400"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)",
          "lineHeight": "1.02",
          "letterSpacing": "-0.025em",
          "fontWeight": "400"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em",
          "fontWeight": "400"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em",
          "fontWeight": "500"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.25",
          "letterSpacing": "-0.01em",
          "fontWeight": "500"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--yellow)",
          "text": "var(--wp--preset--color--navy)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "15px",
          "fontWeight": "600"
        },
        "border": {
          "radius": "4px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--yellow-bright)",
            "text": "var(--wp--preset--color--navy)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "500",
          "fontSize": "22px"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "15px",
          "fontWeight": "500"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--custom--line--default)"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontStyle": "italic"
        },
        "border": {
          "left": {
            "color": "var(--wp--preset--color--yellow)",
            "width": "3px",
            "style": "solid"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    {
      "name": "page-patterns",
      "title": "Pattern page (full-bleed)",
      "postTypes": ["page"]
    }
  ]
}
